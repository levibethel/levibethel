# Replace these placeholder values with your actual Stripe API keys from https://dashboard.stripe.com/apikeys
# Recommendation (stripe-best-practices): Use a Restricted API Key (rk_test_... / rk_live_...) with Checkout Sessions & Webhook permissions
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
DOMAIN=http://localhost:4242

# Stripe Price IDs for the 7 Proposal & Contract Milestone Tiers (https://dashboard.stripe.com/products)
STRIPE_PRICE_LAUNCHPAD_60=price_...
STRIPE_PRICE_LAUNCHPAD_100=price_...
STRIPE_PRICE_FLAGSHIP_30=price_...
STRIPE_PRICE_FLAGSHIP_50=price_...
STRIPE_PRICE_RETAINER_TIER1=price_...
STRIPE_PRICE_RETAINER_TIER2=price_...
STRIPE_PRICE_RETAINER_TIER3=price_...

# Optional Stripe Price IDs for the 3 Digital Billboard & Connected TV (DOOH) Add-On Packages
# (If left as price_..., server.js automatically falls back to inline price_data for the second line_item)
STRIPE_PRICE_DOOH_LOCAL_SPOTLIGHT=price_...
STRIPE_PRICE_DOOH_REGIONAL_TAKEOVER=price_...
STRIPE_PRICE_DOOH_MULTI_MARKET=price_...
